APP_NAME=Stocks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TRUSTED_HOSTS=localhost,127.0.0.1
# Set only to reverse-proxy IPs or CIDRs you control. Never use *.
TRUSTED_PROXIES=
SECURITY_HSTS_MAX_AGE=31536000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

SUPER_ADMIN_EMAIL=admin@stocks.local
SUPER_ADMIN_FIRST_NAME=Protected
SUPER_ADMIN_LAST_NAME=Administrator

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=90

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stocks
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=2100

CACHE_STORE=database
CACHE_LIMITER=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@stocks.local"
MAIL_FROM_NAME="${APP_NAME}"

POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

EODHD_API=
EODHD_CALLS_PER_HOUR=1000
EODHD_CALLS_PER_DAY=100000
EODHD_CALLS_USED_TODAY=0
EODHD_NO_DATA_RETRY_HOURS=12

# Use CLOUDWAYS_CONNECTION for an existing named database connection, or
# configure every dynamic connection variable below with verified TLS.
CLOUDWAYS_CONNECTION=
CLOUDWAYS_HOST=
CLOUDWAYS_PORT=3306
CLOUDWAYS_DATABASE=
CLOUDWAYS_USERNAME=
CLOUDWAYS_PASSWORD=
CLOUDWAYS_CONNECT_TIMEOUT=5
CLOUDWAYS_SSL_CA=
CLOUDWAYS_SSL_VERIFY_SERVER_CERT=true

CLOUDWAYS_API_ACCESS_TOKEN=
CLOUDWAYS_SERVER_ID=
CLOUDWAYS_APP_ID=
CLOUDWAYS_DEPLOY_BRANCH=main

VITE_APP_NAME="${APP_NAME}"
